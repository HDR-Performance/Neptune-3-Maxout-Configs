#!/usr/bin/env bash
set -Eeuo pipefail

SETTINGS_FILE="/etc/default/hdr-pad7-rotation"
STATE_FILE="/etc/hdr-pad7-rotation.state"
MONITOR_FILE="/etc/X11/xorg.conf.d/99-hdr-pad7-monitor.conf"
TOUCH_FILE="/etc/X11/xorg.conf.d/91-hdr-pad7-touchscreen.conf"
LEGACY_TOUCH_FILE="/etc/udev/rules.d/51-hdr-pad7-touchscreen.rules"

[[ "${EUID}" -eq 0 ]] || {
  printf 'Run this command with sudo.\n' >&2
  exit 1
}

if [[ -r "${SETTINGS_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${SETTINGS_FILE}"
fi

DISPLAY_CONNECTOR="${HDR_PAD7_DISPLAY:-HDMI-1}"
TOUCH_NAME="${HDR_PAD7_TOUCH:-BIQU BTT-HDMI7}"
LANDSCAPE_TOUCH_OFFSET="${HDR_PAD7_LANDSCAPE_TOUCH_OFFSET:-0}"
PORTRAIT_TOUCH_OFFSET="${HDR_PAD7_PORTRAIT_TOUCH_OFFSET:-180}"
ANGLE="${1:-0}"

find_theme_dir() {
  local service_user service_home
  if [[ -n "${HDR_PAD7_THEME_DIR:-}" ]]; then
    printf '%s\n' "${HDR_PAD7_THEME_DIR}"
    return
  fi
  service_user="$(systemctl show KlipperScreen.service --property=User --value 2>/dev/null || true)"
  [[ -n "${service_user}" ]] || service_user="$(ps -eo user=,comm= | awk '$2 == "KlipperScreen" {print $1; exit}')"
  [[ -n "${service_user}" ]] || service_user="biqu"
  service_home="$(getent passwd "${service_user}" | cut -d: -f6)"
  [[ -n "${service_home}" ]] || service_home="/home/${service_user}"
  printf '%s\n' "${service_home}/KlipperScreen/styles/neptune-maxout"
}

apply_theme_background() {
  local theme_dir source_image
  theme_dir="$(find_theme_dir)"
  case "${ANGLE}" in
    0|180) source_image="${theme_dir}/background-landscape.png" ;;
    90|270) source_image="${theme_dir}/background-portrait.png" ;;
  esac
  if [[ -f "${source_image}" && -d "${theme_dir}" ]]; then
    install -m 0644 "${source_image}" "${theme_dir}/background.png"
    printf 'Neptune Maxout background switched to %s.\n' "$(basename "${source_image}")"
  fi
}

case "${ANGLE}" in
  0)
    XORG_ROTATION="normal"
    ;;
  90)
    XORG_ROTATION="right"
    ;;
  180)
    XORG_ROTATION="inverted"
    ;;
  270)
    XORG_ROTATION="left"
    ;;
  *)
    printf 'Usage: %s {0|90|180|270}\n' "$0" >&2
    exit 2
    ;;
esac

case "${LANDSCAPE_TOUCH_OFFSET}" in
  0|90|180|270) ;;
  *)
    printf 'HDR_PAD7_LANDSCAPE_TOUCH_OFFSET must be 0, 90, 180, or 270.\n' >&2
    exit 2
    ;;
esac
case "${PORTRAIT_TOUCH_OFFSET}" in
  0|90|180|270) ;;
  *)
    printf 'HDR_PAD7_PORTRAIT_TOUCH_OFFSET must be 0, 90, 180, or 270.\n' >&2
    exit 2
    ;;
esac

# The BTT-HDMI7/Xorg combination needs no additional correction in landscape,
# but it needs a 180-degree correction in portrait. Keep both values explicit
# because one global digitizer offset cannot align all four orientations.
case "${ANGLE}" in
  0|180) ACTIVE_TOUCH_OFFSET="${LANDSCAPE_TOUCH_OFFSET}" ;;
  90|270) ACTIVE_TOUCH_OFFSET="${PORTRAIT_TOUCH_OFFSET}" ;;
esac
TOUCH_ANGLE=$(( (ANGLE + ACTIVE_TOUCH_OFFSET) % 360 ))
case "${TOUCH_ANGLE}" in
  0) TOUCH_MATRIX="1 0 0 0 1 0 0 0 1" ;;
  90) TOUCH_MATRIX="0 -1 1 1 0 0 0 0 1" ;;
  180) TOUCH_MATRIX="-1 0 1 0 -1 1 0 0 1" ;;
  270) TOUCH_MATRIX="0 1 0 -1 0 1 0 0 1" ;;
esac

# The cycle service is active at boot so Moonraker can expose it. During a
# host shutdown systemd also stops the service; do not rotate at that time.
if [[ "${HDR_PAD7_SERVICE_STOP:-0}" == "1" ]]; then
  SYSTEM_STATE="$(systemctl is-system-running 2>/dev/null || true)"
  case "${SYSTEM_STATE}" in
    stopping|offline) exit 0 ;;
  esac
fi

[[ "${DISPLAY_CONNECTOR}" != *'"'* && "${TOUCH_NAME}" != *'"'* ]] || {
  printf 'Display and touch names must not contain quotation marks.\n' >&2
  exit 1
}

install -d -m 0755 /etc/X11/xorg.conf.d

MONITOR_TMP="$(mktemp)"
TOUCH_TMP="$(mktemp)"
trap 'rm -f -- "${MONITOR_TMP}" "${TOUCH_TMP}"' EXIT

cat >"${MONITOR_TMP}" <<EOF
# Managed by HDR Performance Pad 7 rotation controls.
Section "Monitor"
    Identifier "${DISPLAY_CONNECTOR}"
    Option "Rotate" "${XORG_ROTATION}"
    Option "PreferredMode" "1024x600"
EndSection
EOF

cat >"${TOUCH_TMP}" <<EOF
# Managed by HDR Performance Pad 7 rotation controls.
Section "InputClass"
    Identifier "HDR Performance Pad 7 Touchscreen"
    MatchProduct "${TOUCH_NAME}"
    MatchIsTouchscreen "on"
    Driver "libinput"
    Option "CalibrationMatrix" "${TOUCH_MATRIX}"
EndSection
EOF

install -m 0644 "${MONITOR_TMP}" "${MONITOR_FILE}"
install -m 0644 "${TOUCH_TMP}" "${TOUCH_FILE}"
# Earlier versions used a udev libinput calibration rule. This Pad's Xorg
# stack did not apply that rule to its screen coordinates, and combining both
# methods can double-transform input. Keep only the Xorg InputClass rule.
rm -f -- "${LEGACY_TOUCH_FILE}"
printf '%s\n' "${ANGLE}" >"${STATE_FILE}"
chmod 0644 "${STATE_FILE}"
apply_theme_background

printf 'Pad 7 display set to %s degrees; touchscreen matrix set to %s degrees (layout offset %s).\n' \
  "${ANGLE}" "${TOUCH_ANGLE}" "${ACTIVE_TOUCH_OFFSET}"
if [[ "${HDR_PAD7_SKIP_KS_RESTART:-0}" != "1" ]] && \
   systemctl is-active --quiet KlipperScreen.service; then
  systemctl restart KlipperScreen.service
  sleep 2
fi

# CB1 images keep Xorg alive across some KlipperScreen operations and also
# ship a fixed factory rotation. Apply the selected display and touch mapping
# after any KlipperScreen restart so the live X session always finishes in the
# requested state.
SERVICE_USER="$(systemctl show KlipperScreen.service --property=User --value 2>/dev/null || true)"
[[ -n "${SERVICE_USER}" ]] || SERVICE_USER="biqu"
if runuser -u "${SERVICE_USER}" -- env DISPLAY=:0 xrandr --query >/dev/null 2>&1; then
  runuser -u "${SERVICE_USER}" -- env DISPLAY=:0 \
    xrandr --output "${DISPLAY_CONNECTOR}" --rotate "${XORG_ROTATION}"
  # Xorg has already loaded TOUCH_MATRIX through CalibrationMatrix. Keep the
  # live Coordinate Transformation Matrix neutral; applying TOUCH_MATRIX here
  # as well double-rotates CB1 touch input in portrait orientations.
  runuser -u "${SERVICE_USER}" -- env DISPLAY=:0 \
    xinput set-prop "${TOUCH_NAME}" "Coordinate Transformation Matrix" \
      1 0 0 0 1 0 0 0 1
fi
